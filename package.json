{
  "name": "707-activation-builder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"VITE,API\" -c \"cyan,magenta\" \"vite --host 0.0.0.0\" \"npm --prefix server run dev\"",
    "dev:frontend": "vite --host 0.0.0.0",
    "dev:server": "npm --prefix server run dev",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest",
    "server": "npm --prefix server run dev"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "lucide-vue-next": "^0.475.0",
    "pinia": "^3.0.1",
    "qrcode": "^1.5.4",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "vue-tsc": "^2.2.0"
  }
}
